# ── Coaching platform Supabase (own project) ─────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic Claude (clients agent: AI insight chatbot) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini (persona-chat, coach upgrade, recommendations) ──────────────
GEMINI_API_KEY=

# ── LLM Provider ─────────────────────────────────────────────────────────────
# gemini (default) | azure-openai
LLM_PROVIDER=gemini

# ── Azure AI Foundry — Phi-4-mini-reasoning (used when LLM_PROVIDER=azure-openai) ──
# 1. Deploy Phi-4-mini-reasoning in Azure AI Foundry
# 2. Copy the endpoint URL and API key from the Deployments + Endpoint page
# 3. Set LLM_PROVIDER=azure-openai to activate
AZURE_OPENAI_ENDPOINT=https://foundry-models-rg.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
# Deployment name assigned in Azure AI Foundry
AZURE_OPENAI_DEPLOYMENT=Phi-4-mini-reasoning-1
# Embedding deployment (used for RAG indexing when LLM_PROVIDER=azure-openai)
# Deploy e.g. text-embedding-3-small in Azure AI Foundry and set the deployment name here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Override which provider handles embeddings independently of LLM_PROVIDER.
# When LLM_PROVIDER=azure-openai, embeddings automatically use AZURE_OPENAI_EMBEDDING_DEPLOYMENT (text-embedding-3-small).
# Only set this if you explicitly want to use a different provider for embeddings than for chat.
# EMBEDDING_PROVIDER=gemini

# ── YouTube Data API v3 (coach-library agent only) ───────────────────────────
YOUTUBE_API_KEY=

# ── Pinecone (RAG vector search for library content + client chat memory) ─────
# Create a Serverless index at app.pinecone.io — dimension 768, cosine metric
PINECONE_API_KEY=
PINECONE_INDEX=coaching-platform

# ── Whisper transcription (open-source, Python sidecar) ──────────────────────
# pip install openai-whisper  (server Python environment)
# pip install yt-dlp          (YouTube audio extraction fallback)
WHISPER_PYTHON_ENV=python    # path to Python executable with whisper installed (python3 on Linux/macOS, python on Windows)
WHISPER_MODEL=small           # tiny | base | small | medium | large
YTDLP_PATH=yt-dlp             # path to yt-dlp binary

# ── Email — Resend (program-runner: invite emails + nudges) ───────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@coachplatform.com

# ── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_DOMAIN=coachplatform.com
PLATFORM_CUT_PCT=10

# ── Internal shell auth token ────────────────────────────────────────────────
SHELL_INTERNAL_TOKEN=

# ── Skillz agent URLs (external booking/payment/calendar services) ────────────
SKILLZ_AGENT_CALENDAR_AGGREGATOR_URL=https://skillz-calendar-aggregator.agreeablesky-f5e59729.centralus.azurecontainerapps.io
SKILLZ_AGENT_CUSTOMER_BOOKING_URL=https://skillz-customer-booking.agreeablesky-f5e59729.centralus.azurecontainerapps.io
SKILLZ_AGENT_PAYMENT_URL=https://skillz-payment.agreeablesky-f5e59729.centralus.azurecontainerapps.io
SKILLZ_AGENT_AUTH_TOKEN=

# ── Coaching agent ports (local dev) ─────────────────────────────────────────
AGENT_PROGRAM_BUILDER_PORT=3001
AGENT_PROGRAM_RUNNER_PORT=3002
AGENT_COACH_LIBRARY_PORT=3003
AGENT_PERSONA_CHAT_PORT=3004
AGENT_CRM_PORT=3005
AGENT_LICENSING_PORT=3006
AGENT_PAYMENT_PORT=3007
AGENT_CLIENTS_PORT=3008

# ── Internal payment agent (coaching-payment, port 3007) ─────────────────────
# agentBridge resolves 'coaching-payment' to this env var
SKILLZ_AGENT_COACHING_PAYMENT_URL=http://localhost:3007
# Alias used by the portal pay API route (same value)
PAYMENT_AGENT_URL=http://localhost:3007

# ── Stripe CLI webhook listener (local dev only) ─────────────────────────────
# Path to stripe binary; defaults to ~/AppData/Local/stripe/stripe.exe on Windows
# Leave unset to use the default install location; set to skip auto-detection
STRIPE_CLI_PATH=
# Override the forwarding target if the payment agent runs on a different port/host
STRIPE_WEBHOOK_FORWARD_TO=localhost:3007/webhooks/stripe

# Stripe (USD — cards, Google Pay, ACH bank transfers)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Razorpay (INR — UPI, net banking, Indian cards)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── ngrok (local dev — exposes payment agent for Razorpay webhooks) ────────────
# Get your free token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
