ARG AGENT_NAME=01-program-builder
ARG AGENT_MODE=single

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
ARG AGENT_NAME
ARG AGENT_MODE
WORKDIR /app

RUN npm install -g pnpm@10.33.0

# Copy workspace config
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./

# Copy shared packages (needed by agents)
COPY packages/sdk ./packages/sdk
COPY packages/tools ./packages/tools
COPY packages/skills ./packages/skills

# Copy agents (multi-agent mode needs all, single mode needs one)
# Note: Docker COPY doesn't support conditional syntax, so we copy differently based on context
# When building with AGENT_MODE=multi, ensure all agent directories are in build context
# When building with AGENT_MODE=single (default), only the specific agent is needed
COPY packages/agents ./packages/agents

# Install all workspace deps
RUN pnpm install --frozen-lockfile

# Build shared packages, then the agent(s)
RUN pnpm --filter @coaching/sdk build \
 && pnpm --filter @coaching/tools build \
 && pnpm --filter @coaching/skills build

# Build specific agent or all agents depending on mode
RUN if [ "$AGENT_MODE" = "multi" ]; then \
      pnpm --filter "./packages/agents/*" build && \
      npx tsc -p packages/agents/tsconfig.json; \
    else \
      pnpm --filter "./packages/agents/${AGENT_NAME}" build; \
    fi

# Bundle into a single self-contained file (resolves all workspace deps)
RUN if [ "$AGENT_MODE" = "multi" ]; then \
      npx --yes @vercel/ncc build packages/agents/dist/multi-agent-server.js \
        -o /bundle \
        --minify \
        --no-cache; \
    else \
      npx --yes @vercel/ncc build packages/agents/${AGENT_NAME}/dist/index.js \
        -o /bundle \
        --minify \
        --no-cache; \
    fi

# ── Stage 2: Production ───────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app
COPY --from=builder /bundle/index.js ./index.js

# All agents listen on 3000 inside the container (matches Container App targetPort: 3000).
# Local dev overrides these via .env (3001–3007). All vars are set so whichever agent
# binary is running will find its own port var already pointing to 3000.
ENV AGENT_PROGRAM_BUILDER_PORT=3000 \
    AGENT_PROGRAM_RUNNER_PORT=3000 \
    AGENT_COACH_LIBRARY_PORT=3000 \
    AGENT_PERSONA_CHAT_PORT=3000 \
    AGENT_CRM_PORT=3000 \
    AGENT_LICENSING_PORT=3000 \
    AGENT_PAYMENT_PORT=3000

EXPOSE 3000
CMD ["node", "index.js"]
