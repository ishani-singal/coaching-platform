ARG AGENT_NAME=01-program-builder
ARG AGENT_MODE=single

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
ARG AGENT_NAME
ARG AGENT_MODE
WORKDIR /app

RUN npm install -g pnpm@10.33.0

# Copy workspace config
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./

# Copy shared packages (needed by agents)
COPY packages/sdk ./packages/sdk
COPY packages/tools ./packages/tools
COPY packages/skills ./packages/skills
COPY packages/agents ./packages/agents

# Install all workspace deps
RUN pnpm install --frozen-lockfile

# Build shared packages, then the agent(s)
RUN pnpm --filter @coaching/sdk build \
 && pnpm --filter @coaching/tools build \
 && pnpm --filter @coaching/skills build

# Build specific agent or all agents depending on mode
RUN if [ "$AGENT_MODE" = "multi" ]; then \
      pnpm --filter "./packages/agents/*" build && \
      npx tsc -p packages/agents/tsconfig.json; \
    else \
      pnpm --filter "./packages/agents/${AGENT_NAME}" build; \
    fi

# ── Stage 2: Production ───────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

RUN npm install -g pnpm@10.33.0

# Copy workspace config and source so pnpm can wire up the workspace
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/sdk ./packages/sdk
COPY packages/tools ./packages/tools
COPY packages/skills ./packages/skills
COPY packages/agents ./packages/agents

# Install production deps only
RUN pnpm install --frozen-lockfile --prod

# Copy built dist outputs from builder
COPY --from=builder /app/packages/sdk/dist ./packages/sdk/dist
COPY --from=builder /app/packages/tools/dist ./packages/tools/dist
COPY --from=builder /app/packages/skills/dist ./packages/skills/dist
COPY --from=builder /app/packages/agents/dist ./packages/agents/dist
COPY --from=builder /app/packages/agents/01-program-builder/dist ./packages/agents/01-program-builder/dist
COPY --from=builder /app/packages/agents/02-program-runner/dist ./packages/agents/02-program-runner/dist
COPY --from=builder /app/packages/agents/03-coach-library/dist ./packages/agents/03-coach-library/dist
COPY --from=builder /app/packages/agents/04-persona-chat/dist ./packages/agents/04-persona-chat/dist
COPY --from=builder /app/packages/agents/05-crm/dist ./packages/agents/05-crm/dist
COPY --from=builder /app/packages/agents/06-licensing/dist ./packages/agents/06-licensing/dist
COPY --from=builder /app/packages/agents/07-payment/dist ./packages/agents/07-payment/dist

# All agents listen on 3000 inside the container
ENV AGENT_PROGRAM_BUILDER_PORT=3000 \
    AGENT_PROGRAM_RUNNER_PORT=3000 \
    AGENT_COACH_LIBRARY_PORT=3000 \
    AGENT_PERSONA_CHAT_PORT=3000 \
    AGENT_CRM_PORT=3000 \
    AGENT_LICENSING_PORT=3000 \
    AGENT_PAYMENT_PORT=3000

EXPOSE 3000
CMD ["node", "packages/agents/dist/multi-agent-server.js"]
