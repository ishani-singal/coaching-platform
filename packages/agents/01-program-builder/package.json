{
  "name": "@coaching/agent-program-builder",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --ext ts,js,json --watch src --watch node_modules/@coaching/tools/dist --watch node_modules/@coaching/skills/dist --watch node_modules/@coaching/sdk/dist --exec \"ts-node -r dotenv/config src/index.ts\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coaching/sdk": "workspace:*",
    "@coaching/skills": "workspace:*",
    "@coaching/tools": "workspace:*",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}
